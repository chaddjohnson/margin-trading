# Recovery-eligibility program: reproducible optimizer checkpoints and the sweep JSON (the CSVs are kept)
research/vgt-recovery-eligibility/results/search/**/evaluations.jsonl.gz
research/vgt-recovery-eligibility/results/sweeps/*.json
src/recovery-eligibility/generated/

# D1-refinement program: injectable parity copies of the generated strategy files
src/d1-refinement/generated/
# D1-refinement program: per-fold training CSVs of the local studies (29 MB, regenerate with a2-local / stop-variants / no-dip)
research/vgt-d1-refinement/results/**/*_training.csv

# Shared-margin portfolio program: per-minute refused-signal logs (hold semantics logs every re-tested minute; ~60 MB)
research/vgt-shared-margin-portfolio/results/scenarios/*/signals_minutes.csv
research/vgt-shared-margin-portfolio/results/stress/*/signals_minutes.csv
# Shared-margin portfolio program: per-session ledgers of the sensitivity and shock re-runs (regenerate with
# `npm run shared-margin -- run` / `stress`; the principal scenarios' daily.csv and ledger.csv are kept)
research/vgt-shared-margin-portfolio/results/stress/*/daily.csv
research/vgt-shared-margin-portfolio/results/stress/*/ledger.csv
research/vgt-shared-margin-portfolio/results/scenarios/B-*/daily.csv
research/vgt-shared-margin-portfolio/results/scenarios/B2-*/daily.csv

# Multi-ETF D1 program: per-ticker evaluation checkpoints (~75 MB each) and the full candidate tables; the Pareto
# fronts, selections, probes and every nomination's artifacts are kept
research/multi-etf-d1/results/search/*/evaluations.jsonl
research/multi-etf-d1/results/search/*/candidates.csv
# Multi-ETF D1 program: minute-sampled curves of the holdout contenders (regenerate with `holdout --rerun-reason`)
research/multi-etf-d1/results/holdout/*/*/minute_marks.csv
