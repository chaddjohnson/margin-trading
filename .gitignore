.vscode
.DS_Store
node_modules
*.log
dist
*.save
*.bak
.eslintcache
.env
# Market data is local (data/<SYMBOL>/data.csv, archives, caches); only the partition boundaries are versioned.
/data/*
!/data/partitions.json
logs/
state.json
tsconfig.tsbuildinfo
log.txt

# Recovery-eligibility program: reproducible optimizer checkpoints and the sweep JSON (the CSVs are kept)
research/vgt-recovery-eligibility/results/search/**/evaluations.jsonl.gz
research/vgt-recovery-eligibility/results/sweeps/*.json
src/recovery-eligibility/generated/

# D1-refinement program: injectable parity copies of the generated strategy files
src/d1-refinement/generated/
# D1-refinement program: per-fold training CSVs of the local studies (29 MB, regenerate with a2-local / stop-variants / no-dip)
research/vgt-d1-refinement/results/**/*_training.csv

# Shared-margin portfolio program: per-minute refused-signal logs (hold semantics logs every re-tested minute; ~60 MB)
research/vgt-shared-margin-portfolio/results/scenarios/*/signals_minutes.csv
research/vgt-shared-margin-portfolio/results/stress/*/signals_minutes.csv
# Shared-margin portfolio program: per-session ledgers of the sensitivity and shock re-runs (regenerate with
# `npm run shared-margin -- run` / `stress`; the principal scenarios' daily.csv and ledger.csv are kept)
research/vgt-shared-margin-portfolio/results/stress/*/daily.csv
research/vgt-shared-margin-portfolio/results/stress/*/ledger.csv
research/vgt-shared-margin-portfolio/results/scenarios/B-*/daily.csv
research/vgt-shared-margin-portfolio/results/scenarios/B2-*/daily.csv

# Multi-ETF D1 program: per-ticker evaluation checkpoints (~75 MB each) and the full candidate tables; the Pareto
# fronts, selections, probes and every nomination's artifacts are kept
research/multi-etf-d1/results/search/*/evaluations.jsonl
research/multi-etf-d1/results/search/*/candidates.csv
# Multi-ETF D1 program: minute-sampled curves of the holdout contenders (regenerate with `holdout --rerun-reason`)
research/multi-etf-d1/results/holdout/*/*/minute_marks.csv

# Phenotype runs: modules derived from the strategy files for parameter injection (src/phenotype/injection.ts)
/.cache/

# Multi-ETF allocator program: per-session files of the six non-headline combinations and the minute-extreme and
# requirement series of the non-headline principal runs (regenerate with `npm run multi-etf-allocator -- run`); the
# summaries, trades, refusals, annual/monthly series and every headline run's files are kept
research/multi-etf-allocator/results/runs/grid/*/daily.csv
research/multi-etf-allocator/results/runs/grid/*/account_ledger.csv
research/multi-etf-allocator/results/runs/grid/*/margin_requirements.csv
research/multi-etf-allocator/results/runs/grid/*/minute_extremes.csv
research/multi-etf-allocator/results/runs/grid/*/signals.csv
research/multi-etf-allocator/results/runs/grid/*/virtual_trades.csv
research/multi-etf-allocator/results/runs/grid/*/closest_approaches.csv
research/multi-etf-allocator/results/runs/principal/*/minute_extremes.csv
research/multi-etf-allocator/results/runs/principal/*/margin_requirements.csv
!research/multi-etf-allocator/results/runs/principal/B/margin_requirements.csv
!research/multi-etf-allocator/results/runs/principal/C-all-primary-shadow/margin_requirements.csv
!research/multi-etf-allocator/results/runs/principal/C-all-lowDd-shadow/margin_requirements.csv
research/multi-etf-allocator/results/runs/single/

# Explicit --dataset evaluations of the multi-ETF allocator (src/multi-etf-allocator/dataset.ts): local results
/evaluations/
# complementary-etf-d1: the four regression runs are byte-identical copies of the frozen allocator runs (regenerated by
# `npm run complementary-etf-d1 -- regression`; their equality is recorded in results/regression/regression.json)
research/complementary-etf-d1/results/regression/*/
