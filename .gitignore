.vscode
.DS_Store
._.DS_Store
node_modules
*.log
dist
*.save
*.bak
.eslintcache
.env
# Market data is local (data/<SYMBOL>/data.csv, archives, caches); only the partition boundaries are versioned.
/data/*
!/data/partitions.json
logs/
state.json
tsconfig.tsbuildinfo
log.txt

# Recovery-eligibility program: reproducible optimizer checkpoints and the sweep JSON (the CSVs are kept)
research/vgt-recovery-eligibility/results/search/**/evaluations.jsonl.gz
research/vgt-recovery-eligibility/results/sweeps/*.json
src/recovery-eligibility/generated/

# D1-refinement program: injectable parity copies of the generated strategy files
src/d1-refinement/generated/
# D1-refinement program: per-fold training CSVs of the local studies (29 MB, regenerate with a2-local / stop-variants / no-dip)
research/vgt-d1-refinement/results/**/*_training.csv

# Shared-margin portfolio program: per-minute refused-signal logs (hold semantics logs every re-tested minute; ~60 MB)
research/vgt-shared-margin-portfolio/results/scenarios/*/signals_minutes.csv
research/vgt-shared-margin-portfolio/results/stress/*/signals_minutes.csv
# Shared-margin portfolio program: per-session ledgers of the sensitivity and shock re-runs (regenerate with
# `npm run shared-margin -- run` / `stress`; the principal scenarios' daily.csv and ledger.csv are kept)
research/vgt-shared-margin-portfolio/results/stress/*/daily.csv
research/vgt-shared-margin-portfolio/results/stress/*/ledger.csv
research/vgt-shared-margin-portfolio/results/scenarios/B-*/daily.csv
research/vgt-shared-margin-portfolio/results/scenarios/B2-*/daily.csv

# Multi-ETF D1 program: per-ticker evaluation checkpoints (~75 MB each) and the full candidate tables; the Pareto
# fronts, selections, probes and every nomination's artifacts are kept
research/multi-etf-d1/results/search/*/evaluations.jsonl
research/multi-etf-d1/results/search/*/candidates.csv
# Multi-ETF D1 program: minute-sampled curves of the holdout contenders (regenerate with `holdout --rerun-reason`)
research/multi-etf-d1/results/holdout/*/*/minute_marks.csv

# Phenotype runs: modules derived from the strategy files for parameter injection (src/phenotype/injection.ts)
/.cache/

# Multi-ETF allocator program: per-session files of the six non-headline combinations and the minute-extreme and
# requirement series of the non-headline principal runs (regenerate with `npm run multi-etf-allocator -- run`); the
# summaries, trades, refusals, annual/monthly series and every headline run's files are kept
research/multi-etf-allocator/results/runs/grid/*/daily.csv
research/multi-etf-allocator/results/runs/grid/*/account_ledger.csv
research/multi-etf-allocator/results/runs/grid/*/margin_requirements.csv
research/multi-etf-allocator/results/runs/grid/*/minute_extremes.csv
research/multi-etf-allocator/results/runs/grid/*/signals.csv
research/multi-etf-allocator/results/runs/grid/*/virtual_trades.csv
research/multi-etf-allocator/results/runs/grid/*/closest_approaches.csv
research/multi-etf-allocator/results/runs/principal/*/minute_extremes.csv
research/multi-etf-allocator/results/runs/principal/*/margin_requirements.csv
!research/multi-etf-allocator/results/runs/principal/B/margin_requirements.csv
!research/multi-etf-allocator/results/runs/principal/C-all-primary-shadow/margin_requirements.csv
!research/multi-etf-allocator/results/runs/principal/C-all-lowDd-shadow/margin_requirements.csv
research/multi-etf-allocator/results/runs/single/

# Explicit --dataset evaluations of the multi-ETF allocator (src/multi-etf-allocator/dataset.ts): local results
/evaluations/
# complementary-etf-d1: the four regression runs are byte-identical copies of the frozen allocator runs (regenerated by
# `npm run complementary-etf-d1 -- regression`; their equality is recorded in results/regression/regression.json)
research/complementary-etf-d1/results/regression/*/
# portfolio-aware-d1: deterministic, regenerable trial logs (`stage-a`, `stage-b`; ~83 MB) and the controls' copies of
# the frozen allocator runs (byte-identical to research/multi-etf-allocator/results/runs/principal/, checked by
# `controls`). Kept on disk; their summaries, selections and hashes are tracked.
research/portfolio-aware-d1-optimization/results/stageA/evaluations/*.jsonl
research/portfolio-aware-d1-optimization/results/stageB/*/track-*/*.jsonl
research/portfolio-aware-d1-optimization/results/controls/legacy-runs/
# joint-16-etf-d1: deterministic, regenerable logs of the training search (`search`; every vector trace record and
# every evaluated configuration); their summaries, selections and sha256 (FROZEN_SELECTION.json `records`) are tracked.
research/joint-16-etf-d1/results/library/library.jsonl
research/joint-16-etf-d1/results/discovery/evaluations.jsonl
research/joint-16-etf-d1/results/refine/evaluations.jsonl
# d1-robust-pool-discovery: deterministic, regenerable logs of every evaluated configuration (`walkforward`, `search`);
# their summaries, selections and sha256 are tracked
research/d1-robust-pool-discovery/results/**/discovery.jsonl
research/d1-robust-pool-discovery/results/determinism/*.jsonl
# d1-diverse-pool-discovery: deterministic, regenerable logs of every evaluated configuration per arm (`search`) and the
# determinism re-runs; their summaries, selections and sha256 (sealed search manifests) are tracked
research/d1-diverse-pool-discovery/results/rounds/**/archive.jsonl
research/d1-diverse-pool-discovery/results/determinism/**/archive.jsonl
# study5-gdx-d1-b5-three-etf: deterministic, regenerable search archives (Study A screen/GA, Track 1 Stage A and
# tracks, Track 2a pool archive; ~50 MB); their sha256 are in the sealed stage records, which are tracked
research/study5-gdx-d1-b5-three-etf-2026-10/results/studyA/*/screen.jsonl
research/study5-gdx-d1-b5-three-etf-2026-10/results/studyA/*/ga-r*.jsonl
research/study5-gdx-d1-b5-three-etf-2026-10/results/track1/*/*.jsonl
research/study5-gdx-d1-b5-three-etf-2026-10/results/track2/archive.jsonl

# Strategy Lab runtime state: SQLite database, run artifacts, imports, API token (apps/strategy-lab, docs/strategy-lab)
/state/

# growth140-vgt-s8m: the search's per-evaluation point archive (≈ 81 MB gzip; regenerable from the frozen code, seeds and
# data; its sha256 is in research/growth140-vgt-s8m/results/archive/MANIFEST.json; the SQLite original is in .cache/)
research/growth140-vgt-s8m/results/archive/search/points-*.jsonl.gz
# growth140-vgt-stable: the four searches' per-evaluation point and configuration shards (65–81 MB and ≈ 19 MB gzip
# each; regenerable from the frozen code, seeds and doors; sha256 in research/growth140-vgt-stable/results/archive/
# MANIFEST.json; the SQLite originals are in .cache/). The fits shards (every centre with its neighbourhood) are kept.
research/growth140-vgt-stable/results/archive/search-*/points-*.jsonl.gz
research/growth140-vgt-stable/results/archive/search-*/configs-*.jsonl.gz

# GPU Phase 1 feasibility (research/gpu-phase1-feasibility): compiled CUDA binaries, exported binary bar caches and raw
# profiler/benchmark scratch are local build artifacts (rebuild with the commands in RUN_COMMANDS.md); only sources,
# reports and small CSV/JSON metrics are versioned
research/gpu-phase1-feasibility/build/
research/gpu-phase1-feasibility/cache/
research/gpu-phase1-feasibility/results/raw-large/
# GPU Phase 2 (research/gpu-phase2) and the GPU backend: compiled CUDA binaries, exported binary datasets, job caches
# and large raw outputs (local build artifacts; their sha256 are recorded in the study's records)
research/gpu-phase2/build/
research/gpu-phase2/cache/
research/gpu-phase2/results/raw-large/
# GPU Phase 3 (research/gpu-phase3): compiled CUDA binaries, exported binary datasets, job caches and large raw outputs
# (local build artifacts; their sha256 are recorded in the study's records)
research/gpu-phase3/build/
research/gpu-phase3/cache/
research/gpu-phase3/results/raw-large/
# GPU Phase 4 (research/gpu-phase4): compiled CUDA binaries, exported binary datasets, per-job benchmark caches and
# large raw outputs (key -> hash maps); unit logs are copied into results/runlogs/ at the end
research/gpu-phase4/build/
research/gpu-phase4/cache/
research/gpu-phase4/results/raw-large/
research/gpu-phase4/results/logs/
# GPU Phase 5 (research/gpu-phase5): compiled CUDA binaries, exported binary datasets, per-job caches, large raw
# outputs and unit logs (their sha256 or digests are recorded in the study's records)
research/gpu-phase5/build/
research/gpu-phase5/cache/
research/gpu-phase5/results/raw-large/
research/gpu-phase5/results/logs/
research/gpu-phase5/results/**/*.bin
# GPU Phase 6 (research/gpu-phase6): its build and caches, large raw outputs and unit logs
research/gpu-phase6/build/
research/gpu-phase6/cache/
research/gpu-phase6/results/raw-large/
research/gpu-phase6/results/logs/
# GPU Phase 7 (research/gpu-phase7, the risk-envelope delivery and its acceptance): its build and caches, large raw
# outputs, unit logs and the scratch restores of compressed archives (their sha256 are recorded in the study's records)
research/gpu-phase7/build/
research/gpu-phase7/cache/
research/gpu-phase7/results/raw-large/
research/gpu-phase7/results/logs/
research/gpu-phase7/results/jobs/*/logs/
# Job namespaces of every study (src/gpu-jobs/jobs.ts, docs/gpu/README.md §4c): each job's state directory (archive,
# checkpoint, its own dataset cache, ownership lock) and its log directory; the job's records (identity, events,
# receipts, telemetry, results) under results/jobs/<job>/ are kept
research/*/cache/jobs/
research/*/results/jobs/*/logs/
# The risk-envelope pilot (research/vg-l0-risk-envelope-pilot): its git-ignored state — engineering and diagnostic job
# archives and datasets, per-lot row caches — and unit logs (their records and sha256 are committed)
research/vg-l0-risk-envelope-pilot/cache/
research/vg-l0-risk-envelope-pilot/results/logs/
research/vg-l0-risk-envelope-pilot/results/raw-large/
# Stage B (research/vg-l0-risk-envelope-stage-b): its git-ignored state — engineering and analysis archives and datasets,
# per-lot row caches — unit logs and large raw outputs (their records and sha256 are committed)
research/vg-l0-risk-envelope-stage-b/cache/
research/vg-l0-risk-envelope-stage-b/results/logs/
research/vg-l0-risk-envelope-stage-b/results/raw-large/

# GPU Phase 8 (research/gpu-phase8, the staged-stop delivery) and Priority 4 (research/vg-l0-staged-stop): compiled CUDA
# binaries, exported binary datasets, job caches and large raw outputs (recorded by sha256 in their reports)
research/gpu-phase8/build/
research/gpu-phase8/cache/
research/gpu-phase8/results/raw-large/
research/gpu-phase8/results/logs/
research/vg-l0-staged-stop/cache/
