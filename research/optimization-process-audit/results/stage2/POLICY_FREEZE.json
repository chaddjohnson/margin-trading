  {
   "key": "P0",
   "family": "reference (unchanged original rule)",
   "name": "actual profit",
   "formula": "the highest centre net among E(s, c); ties by the higher selection robust net, the lower centre DD, then the label"
  },
  {
   "key": "P1",
   "family": "severity-aware",
   "name": "tail-mean-constrained actual profit",
   "formula": "admissible iff the selection family’s worst-10% mean DD (mean of the ⌈0.1 n⌉ largest of the pooled, de-duplicated 2 × 128 selection draws’ maximum minute DDs) ≤ $35,000; the admissible member with the highest centre net (profit order); none admissible → no selection"
  },
  {
   "key": "P2",
   "family": "subperiod consistency",
   "name": "best-year-excluded neighbourhood profit",
   "formula": "the highest median over the pooled selection draws of (draw net − the draw’s best calendar-year marked P&L); ties by profit order"
  },
  {
   "key": "P3",
   "family": "episode sensitivity",
   "name": "profit without new funding in the leading episode",
   "formula": "the highest causal centre net from a rerun refusing every new decision inside the largest winning pool-level episode (first decision session → last exit; no winning episode → the centre net); ties by profit order"
  }
 ],
