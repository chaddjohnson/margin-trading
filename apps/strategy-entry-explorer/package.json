{
  "name": "strategy-entry-explorer",
  "private": true,
  "license": "UNLICENSED",
  "description": "Local research UI that charts a price series with the entry events of strategy variations (demo: synthetic data)",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "node scripts/ensure-deps.mjs && vite --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "generate:fixture": "node --disable-warning=ExperimentalWarning scripts/generate-fixture.ts"
  },
  "dependencies": {
    "dygraphs": "2.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@types/dygraphs": "2.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
